<div class="hero-compact" data-scroll-trigger>
  <div class="hero-compact__inner">
    <% if local_assigns[:label].present? %>
      <p class="hero-compact__label"><%= label %></p>
    <% end %>
    <h1 class="hero-compact__title hero-compact__title--underlined"><%= title %></h1>
    <p class="hero-compact__sub"><%= subtitle %></p>
  </div>
</div>
