<%= link_to root_path, class: "site-logo", id: "site-logo", aria: { label: "Retour à l'accueil" } do %>
  <%= image_tag "/logo_bg_circle_light.avif", alt: "Koi's Story" %>
<% end %>

<div class="site-partner" aria-label="Partenaire exclusif français Konishi">
  <span class="site-partner__eyebrow">Partenaire exclusif français</span>
  <%= image_tag "/logo_konishi_black.avif",
        alt: "Logo Konishi",
        class: "site-partner__logo" %>
</div>

<header class="site-header" id="site-header">
  <div class="header__inner">
    <nav class="header__nav" id="header-nav" aria-label="Navigation principale" data-testid="public-nav">
      <span class="nav__indicator" id="nav-indicator"></span>
      <ul>
        <li><%= link_to "Accueil", root_path, data: { testid: "nav-home" } %></li>
        <li><%= link_to "Nous découvrir", decouvrir_path, data: { testid: "nav-decouvrir" } %></li>
        <li><%= link_to "Nos Koïs", kois_path, data: { testid: "nav-kois" } %></li>
        <li class="has-dropdown" data-testid="nav-products-group">
          <% produits_active = [materiel_path, nourriture_path, soins_path].include?(request.path) %>
          <button type="button" class="dropdown-toggle<%= ' active' if produits_active %>" aria-haspopup="true" aria-expanded="false" data-testid="nav-products-toggle">
            Produits
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="2,4 6,8 10,4"/>
            </svg>
          </button>
          <ul class="dropdown" data-testid="nav-products-menu">
            <li><%= link_to "Matériel", materiel_path, data: { testid: "nav-products-materiel" } %></li>
            <li><%= link_to "Nourriture", nourriture_path, data: { testid: "nav-products-nourriture" } %></li>
            <li><%= link_to "Soins", soins_path, data: { testid: "nav-products-soins" } %></li>
          </ul>
        </li>
        <li><%= link_to "Azukari", azukari_path, data: { testid: "nav-azukari" } %></li>
        <li><%= link_to "À propos", a_propos_path, data: { testid: "nav-a-propos" } %></li>
      </ul>
    </nav>

    <button type="button" class="header__burger" id="burger" aria-label="Menu" aria-controls="header-nav" aria-expanded="false" data-testid="nav-burger">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="nav-backdrop" id="nav-backdrop"></div>
