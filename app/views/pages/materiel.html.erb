<% content_for :title, "Matériel | Koi's Story" %>
<% content_for :skip_default_footer, true %>
<%
  filtration_items = [
    { icon: "⚙️", badge: "Filtration", name: "Filtre à tambour", description: "Filtration mécanique automatique, idéal pour les bassins à forte charge." },
    { icon: "🔄", badge: "Filtration", name: "Filtre à grille", description: "Pré-filtration efficace des débris avant le passage en filtration biologique." },
    { icon: "🧹", badge: "Filtration", name: "Filtre multi-chambre", description: "Système à plusieurs étapes pour une filtration mécanique et biologique complète." },
    { icon: "🚿", badge: "Filtration", name: "Filtre à douche", description: "Filtration biologique par ruissellement, favorise l'oxygénation et la colonisation bactérienne." }
  ]
  pump_items = [
    { icon: "💧", badge: "Pompes", name: "Pompe de bassin", description: "Pompe haute performance, débit réglable, très faible consommation." },
    { icon: "☀️", badge: "UV", name: "Stérilisateur UV", description: "Élimine bactéries et algues. Eau cristalline garantie. De 25 W à 110 W." },
    { icon: "🌡️", badge: "Chauffage", name: "Chauffage bassin", description: "Maintien de la température optimale pour favoriser la croissance et la santé." }
  ]
%>
<%= render "pages/home_header" %>
<%= render "pages/product_hero", title: "Matériel", subtitle: "Filtration, pompes, UV, chauffage, tout le nécessaire pour vos koïs." %>
<main id="main-content">
  <div class="shop-section">
    <div class="shop-section__inner">
      <%= render "pages/shop_category", title: "Filtration", items: filtration_items %>
      <%= render "pages/shop_category", title: "Pompes & UV", items: pump_items %>
    </div>
  </div>
</main>
<%= render "pages/home_footer" %>
