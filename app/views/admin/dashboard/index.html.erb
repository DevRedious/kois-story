<div class="page-greeting">Bonjour, <%= admin_user_display_name %></div>
<div class="page-date"><%= l(Date.current, format: :long) rescue Date.current.strftime("%d/%m/%Y") %></div>

<div class="resource-hero" data-testid="admin-dashboard-hero">
  <div class="resource-hero__content">
    <div class="resource-hero__eyebrow">Pilotage admin</div>
    <h2 class="resource-hero__title">Vue d'ensemble Koi's Story</h2>
    <p class="resource-hero__text">Priorisez les messages chauds, gardez un oeil sur les commandes en attente et les paiements a relancer depuis un seul point d'entree.</p>
  </div>
  <div class="resource-metrics">
    <div class="resource-metric">
      <span class="resource-metric__label">Messages nouveaux</span>
      <strong class="resource-metric__value"><%= @unread_messages_count %></strong>
    </div>
    <div class="resource-metric">
      <span class="resource-metric__label">Commandes a valider</span>
      <strong class="resource-metric__value"><%= @pending_orders_count %></strong>
    </div>
    <div class="resource-metric">
      <span class="resource-metric__label">Paiements en retard</span>
      <strong class="resource-metric__value"><%= @overdue_payments_count %></strong>
    </div>
  </div>
</div>

<div class="quick-actions" data-testid="admin-quick-actions">
  <%= link_to "＋ Nouveau koi", new_admin_koi_path, class: "btn btn--primary", data: { testid: "admin-quick-new-koi" } %>
  <%= link_to "＋ Nouveau produit", new_admin_product_path, class: "btn btn--primary", data: { testid: "admin-quick-new-product" } %>
  <%= link_to "Voir les messages", admin_messages_path, class: "btn btn--dark", data: { testid: "admin-quick-messages" } %>
  <%= link_to "Voir les commandes", admin_orders_path, class: "btn btn--dark", data: { testid: "admin-quick-orders" } %>
  <%= link_to "Voir les paiements", admin_payments_path, class: "btn btn--dark", data: { testid: "admin-quick-payments" } %>
  <%= link_to "Voir le site", public_site_url, class: "btn btn--outline", data: { testid: "admin-quick-public-site" } %>
</div>

<div class="stats-grid stats-6">
  <div class="stat-card c-dispo">
    <div class="stat-label">Kois disponibles</div>
    <div class="stat-value"><%= @available_kois_count %></div>
    <div class="stat-sub up">Catalogue public synchronise</div>
  </div>
  <div class="stat-card c-arrivage">
    <div class="stat-label">Kois en arrivage</div>
    <div class="stat-value"><%= @incoming_kois_count %></div>
    <div class="stat-sub">A preparer pour la mise en ligne</div>
  </div>
  <div class="stat-card c-konishi">
    <div class="stat-label">Messages recus</div>
    <div class="stat-value"><%= @messages_count %></div>
    <div class="stat-sub">Depuis le lancement</div>
  </div>
  <div class="stat-card c-messages">
    <div class="stat-label">Messages non lus</div>
    <div class="stat-value"><%= @unread_messages_count %></div>
    <div class="stat-sub down">A traiter en priorite</div>
  </div>
  <div class="stat-card c-commandes">
    <div class="stat-label">Commandes en attente</div>
    <div class="stat-value"><%= @pending_orders_count %></div>
    <div class="stat-sub"><%= @confirmed_orders_count %> confirmees</div>
  </div>
  <div class="stat-card c-paiements">
    <div class="stat-label">Paiements a suivre</div>
    <div class="stat-value"><%= @pending_payments_count + @partial_payments_count %></div>
    <div class="stat-sub"><%= @overdue_payments_count %> en retard</div>
  </div>
  <div class="stat-card c-dispo">
    <div class="stat-label">Clients</div>
    <div class="stat-value"><%= @clients_count %></div>
    <div class="stat-sub"><%= @payments_count %> paiements lies</div>
  </div>
  <div class="stat-card c-konishi">
    <div class="stat-label">CA confirme</div>
    <div class="stat-value"><%= number_to_currency(@confirmed_revenue_amount || 0, unit: "", precision: 0, delimiter: " ").strip %> €</div>
    <div class="stat-sub"><%= @completed_orders_count %> commandes finalisees</div>
  </div>
</div>

<div class="dashboard-panels">
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Derniers messages recus</div>
      <%= link_to "Voir tout", admin_messages_path, class: "btn btn--outline btn--sm" %>
    </div>
    <% if @recent_messages.any? %>
      <div class="dashboard-feed">
        <% @recent_messages.each do |message| %>
          <article class="dashboard-item">
            <div class="dashboard-item__top">
              <div>
                <div class="dashboard-item__title"><%= link_to message.sender_name, admin_message_path(message) %></div>
                <div class="dashboard-item__meta"><%= message.contact_reference %> · <%= admin_message_datetime(message) %></div>
              </div>
              <span class="badge <%= admin_message_status_badge_class(message) %>"><%= admin_message_status_label(message) %></span>
            </div>
            <p class="dashboard-item__text"><%= truncate(message.body, length: 88) %></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="dashboard-empty">Aucun message pour le moment.</div>
    <% end %>
  </div>

  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Commandes recentes</div>
      <%= link_to "Ouvrir les commandes", admin_orders_path, class: "btn btn--outline btn--sm" %>
    </div>
    <% if @recent_orders.any? %>
      <div class="dashboard-feed">
        <% @recent_orders.each do |order| %>
          <article class="dashboard-item">
            <div class="dashboard-item__top">
              <div>
                <div class="dashboard-item__title"><%= link_to admin_order_reference(order), admin_order_path(order) %></div>
                <div class="dashboard-item__meta"><%= admin_order_client_name(order) %></div>
              </div>
              <span class="badge <%= admin_order_status_badge_class(order) %>"><%= admin_order_status_label(order) %></span>
            </div>
            <p class="dashboard-item__text"><%= number_to_currency(order.total_amount || 0, unit: "", precision: 2, delimiter: " ").strip %> € · <%= admin_order_payments_label(order) %></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="dashboard-empty">Aucune commande enregistree pour le moment.</div>
    <% end %>
  </div>

  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Paiements recents</div>
      <%= link_to "Ouvrir les paiements", admin_payments_path, class: "btn btn--outline btn--sm" %>
    </div>
    <% if @recent_payments.any? %>
      <div class="dashboard-feed">
        <% @recent_payments.each do |payment| %>
          <article class="dashboard-item">
            <div class="dashboard-item__top">
              <div>
                <div class="dashboard-item__title"><%= link_to admin_order_reference(payment.order), admin_payment_path(payment) %></div>
                <div class="dashboard-item__meta"><%= payment.order.client_profile&.name || "Client inconnu" %></div>
              </div>
              <span class="badge <%= admin_payment_status_badge_class(payment) %>"><%= admin_payment_status_label(payment) %></span>
            </div>
            <p class="dashboard-item__text"><%= number_to_currency(payment.amount || 0, unit: "", precision: 2, delimiter: " ").strip %> € · <%= admin_payment_due_label(payment) %></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="dashboard-empty">Aucun paiement enregistre pour le moment.</div>
    <% end %>
  </div>
</div>
