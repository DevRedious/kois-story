<%= form_with model: [ :admin, product ], local: true do |f| %>
  <% if product.errors.any? %>
    <div class="panel">
      <div class="panel-title">Le formulaire contient des erreurs</div>
      <ul>
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="panel">
    <div class="panel-header">
      <div class="panel-title">Informations produit</div>
    </div>
    <div class="form-grid">
      <div class="form-group">
        <%= f.label :name, "Nom" %>
        <%= f.text_field :name, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :reference, "Reference" %>
        <%= f.text_field :reference, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :category, "Categorie" %>
        <%= f.select :category, Product.categories.keys.map { |key| [ key.humanize, key ] }, {}, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :status, "Statut" %>
        <%= f.select :status, Product.statuses.keys.map { |key| [ key.humanize, key ] }, {}, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :price, "Prix (€)" %>
        <%= f.number_field :price, min: 0, step: 0.01, required: true %>
      </div>
      <div class="form-group">
        <%= f.label :stock_quantity, "Stock" %>
        <%= f.number_field :stock_quantity, min: 0, step: 1 %>
      </div>
    </div>
    <div class="form-group mt-2">
      <%= f.label :description, "Description" %>
      <%= f.text_area :description %>
    </div>
  </div>

  <div class="form-footer">
    <%= link_to "Annuler", admin_products_path, class: "btn btn--outline" %>
    <%= f.submit(product.persisted? ? "Mettre a jour le produit" : "Enregistrer le produit", class: "btn btn--primary") %>
  </div>
<% end %>
