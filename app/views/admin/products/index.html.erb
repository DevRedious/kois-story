<div class="page-sub">Gestion du catalogue materiel, soins et nourriture.</div>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">Produits</div>
    <div class="panel-toolbar admin-filter-form">
      <%= form_with url: admin_products_path, method: :get, class: "panel-toolbar admin-filter-form__row", local: true do |form| %>
        <%= form.search_field :q, value: params[:q], placeholder: "Nom, reference ou description", class: "u-toolbar-control admin-filter-form__grow" %>
        <%= form.select :category, options_for_select([["Toutes categories", ""]] + Product.categories.keys.map { |key| [key.humanize, key] }, params[:category]), {}, class: "u-toolbar-select-wide" %>
        <%= form.select :status, options_for_select([["Tous statuts", ""]] + Product.statuses.keys.map { |key| [key.humanize, key] }, params[:status]), {}, class: "u-toolbar-select-wide" %>
        <%= form.submit "Filtrer", class: "btn btn--outline btn--sm" %>
        <% if params[:q].present? || params[:category].present? || params[:status].present? %>
          <%= link_to "Reinitialiser", admin_products_path, class: "btn btn--ghost btn--sm" %>
        <% end %>
      <% end %>
      <%= link_to "Nouveau produit", new_admin_product_path, class: "btn btn--primary btn--sm" %>
    </div>
  </div>
  <div class="table-responsive">
    <table>
      <thead>
        <tr><th><%= admin_sort_link("Nom", :name) %></th><th><%= admin_sort_link("Reference", :reference) %></th><th><%= admin_sort_link("Categorie", :category) %></th><th><%= admin_sort_link("Prix", :price) %></th><th><%= admin_sort_link("Stock", :stock_quantity) %></th><th><%= admin_sort_link("Statut", :status) %></th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% @products.each do |product| %>
          <tr>
            <td><strong><%= link_to product.name, admin_product_path(product) %></strong></td>
            <td><%= product.reference %></td>
            <td><%= admin_product_category_label(product) %></td>
            <td><%= number_to_currency(product.price, unit: "", precision: 2, delimiter: " ").strip %> €</td>
            <td><%= product.stock_quantity || 0 %></td>
            <td><span class="badge <%= admin_product_status_badge_class(product) %>"><%= admin_product_status_label(product) %></span></td>
            <td>
              <div class="td-actions">
                <%= link_to "Voir", admin_product_path(product), class: "btn btn--ghost btn--sm" %>
                <%= link_to "Editer", edit_admin_product_path(product), class: "btn btn--outline btn--sm" %>
                <%= button_to "Supprimer", admin_product_path(product), method: :delete, class: "btn btn--danger btn--sm", form: { data: { turbo_confirm: "Supprimer #{product.name} ?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "admin/shared/pagination", pagination: @pagination, item_name: "produits" %>
</div>
