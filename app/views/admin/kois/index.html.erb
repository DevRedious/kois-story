<div class="page-sub">Gestion du catalogue, des statuts de vente et de la lignée Konishi.</div>

<div class="panel panel--koi-list">
  <div class="panel-header">
    <span class="panel-title">Tous les kois</span>
    <%= form_with url: admin_kois_path, method: :get, class: "panel-toolbar admin-filter-form", local: true do |form| %>
      <%= form.search_field :q, value: params[:q], placeholder: "Nom, variete ou description", class: "u-toolbar-control admin-filter-form__grow" %>
      <%= form.select :variety, options_for_select([["Toutes varietes", ""]] + @varieties.map { |variety| [variety, variety] }, params[:variety]), {}, class: "u-toolbar-select-wide" %>
      <%= form.select :status, options_for_select([["Tous statuts", ""], ["Disponible", "available"], ["Arrivage", "incoming"], ["Vendu", "sold_out"]], params[:status]), {}, class: "u-toolbar-select-wide" %>
      <%= form.select :lineage, options_for_select([["Toutes lignees", ""], ["Konishi", "konishi"], ["Standard", "standard"]], params[:lineage]), {}, class: "u-toolbar-select-wide" %>
      <%= form.submit "Filtrer", class: "btn btn--outline btn--sm" %>
      <% if params[:q].present? || params[:variety].present? || params[:status].present? || params[:lineage].present? %>
        <%= link_to "Reinitialiser", admin_kois_path, class: "btn btn--ghost btn--sm" %>
      <% end %>
      <span class="filter-count"><%= @pagination[:total_count] %> koi<%= "s" if @pagination[:total_count] > 1 %></span>
    <% end %>
  </div>

  <div class="table-responsive">
    <table id="kois-table">
      <thead>
        <tr>
          <th><%= admin_sort_link("Koi", :name) %></th>
          <th>Classe / Age</th>
          <th><%= admin_sort_link("Taille", :size_cm) %></th>
          <th><%= admin_sort_link("Prix", :price) %></th>
          <th>Lignee</th>
          <th><%= admin_sort_link("Statut", :status) %></th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @kois.each do |koi| %>
          <tr data-status="<%= koi.status %>" data-variety="<%= koi.variety.to_s.downcase %>" data-lineage="<%= admin_koi_lineage_value(koi) %>">
            <td>
              <div class="koi-cell">
                <% if admin_koi_image_source(koi).present? %>
                  <%= image_tag admin_koi_image_source(koi), alt: "", class: "koi-thumb koi-thumb-sm" %>
                <% else %>
                  <div class="koi-thumb koi-thumb-sm">?</div>
                <% end %>
                <div>
                  <div class="koi-name"><%= koi.name %></div>
                  <div class="koi-variety"><%= koi.variety %></div>
                </div>
              </div>
            </td>
            <td><span class="koi-meta-label"><%= admin_koi_age_label(koi) %><%= " · #{koi.age} ans" if koi.age.present? %></span></td>
            <td><%= koi.size_cm.present? ? "#{koi.size_cm} cm" : "-" %></td>
            <td class="koi-price"><%= number_to_currency(koi.price, unit: "", precision: 0, delimiter: " ").strip %> €</td>
            <td>
              <% if koi.konishi_lineage? %>
                <span class="badge badge-konishi">Konishi</span>
              <% else %>
                —
              <% end %>
            </td>
            <td><span class="badge <%= admin_koi_status_badge_class(koi) %>"><%= admin_koi_status_label(koi) %></span></td>
            <td>
              <div class="td-actions">
                <%= link_to "Voir", admin_koi_path(koi), class: "btn btn--ghost btn--sm" %>
                <%= link_to "Editer", edit_admin_koi_path(koi), class: "btn btn--outline btn--sm" %>
                <%= button_to "Supprimer", admin_koi_path(koi), method: :delete, class: "btn btn--danger btn--sm", form: { data: { turbo_confirm: "Supprimer #{koi.name} ?" } } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "admin/shared/pagination", pagination: @pagination, item_name: "kois" %>
</div>
