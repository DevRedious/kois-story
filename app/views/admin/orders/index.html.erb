<div class="page-sub">Suivi des commandes clients, des lignes kois/produits et de leur avancement.</div>

<div class="resource-hero">
  <div class="resource-hero__content">
    <div class="resource-hero__eyebrow">Suivi commercial</div>
    <h2 class="resource-hero__title">Commandes et priorites</h2>
    <p class="resource-hero__text">Consultez rapidement les commandes a confirmer, le chiffre d'affaires en cours et les clients a relancer.</p>
  </div>
  <div class="resource-metrics">
    <div class="resource-metric">
      <span class="resource-metric__label">Total</span>
      <strong class="resource-metric__value"><%= @pagination[:total_count] %></strong>
    </div>
    <div class="resource-metric">
      <span class="resource-metric__label">En attente</span>
      <strong class="resource-metric__value"><%= @orders.count(&:pending?) %></strong>
    </div>
    <div class="resource-metric">
      <span class="resource-metric__label">Validees</span>
      <strong class="resource-metric__value"><%= @orders.count(&:confirmed?) %></strong>
    </div>
  </div>
</div>

<div class="panel">
  <div class="panel-header">
    <div class="panel-title">Commandes</div>
    <%= form_with url: admin_orders_path, method: :get, class: "panel-toolbar admin-filter-form", local: true do |form| %>
      <%= form.search_field :q, value: params[:q], id: "order-search", class: "u-toolbar-control admin-filter-form__grow", placeholder: "Reference, client ou note" %>
      <%= form.select :status, options_for_select([["Tous les statuts", ""], ["En attente", "pending"], ["Confirmees", "confirmed"], ["Finalisees", "completed"], ["Annulees", "cancelled"]], params[:status]), { }, id: "status-filter", class: "u-toolbar-select-wide" %>
      <%= form.submit "Filtrer", class: "btn btn--outline btn--sm" %>
      <% if params[:q].present? || params[:status].present? %>
        <%= link_to "Reinitialiser", admin_orders_path, class: "btn btn--ghost btn--sm" %>
      <% end %>
    <% end %>
  </div>
  <div class="table-responsive">
    <table id="orders-table">
      <thead>
        <tr><th>Reference</th><th>Client</th><th>Articles</th><th>Paiements</th><th>Total</th><th>Statut</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% if @orders.any? %>
          <% @orders.each do |order| %>
          <tr data-status="<%= order.status %>">
            <td><strong><%= admin_order_reference(order) %></strong></td>
            <td><%= link_to admin_order_client_name(order), admin_client_path(order.client_profile) %></td>
            <td><%= order.order_items.size %> ligne<%= "s" if order.order_items.many? %></td>
            <td class="u-fs-sm u-text-muted"><%= admin_order_payments_label(order) %></td>
            <td class="amount-cell"><span class="amount-ttc"><%= number_to_currency(order.total_amount || 0, unit: "", precision: 2, delimiter: " ").strip %> €</span></td>
            <td><span class="badge <%= admin_order_status_badge_class(order) %>"><%= admin_order_status_label(order) %></span></td>
            <td>
              <div class="td-actions">
                <%= link_to "Voir", admin_order_path(order), class: "btn btn--outline btn--sm" %>
                <% if order.payments.any? %>
                  <%= link_to "Paiements", admin_payment_path(order.payments.first), class: "btn btn--outline btn--sm" %>
                <% end %>
                <%= link_to "Editer", edit_admin_order_path(order), class: "btn btn--ghost btn--sm" %>
              </div>
            </td>
          </tr>
          <% end %>
        <% else %>
          <tr><td colspan="7">Aucune commande a suivre pour le moment.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "admin/shared/pagination", pagination: @pagination, item_name: "commandes" %>
</div>
