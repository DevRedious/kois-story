<div class="page-sub">Mettez a jour le statut et les notes de la commande.</div>

<%= form_with model: [ :admin, @order ], local: true do |f| %>
  <div class="panel">
    <div class="panel-header">
      <div class="panel-title"><%= admin_order_reference(@order) %></div>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label>Client</label>
        <input type="text" value="<%= admin_order_client_name(@order) %>" disabled>
      </div>
      <div class="form-group">
        <%= f.label :status, "Statut" %>
        <%= f.select :status, Order.statuses.keys.map { |key| [ key.humanize, key ] } %>
      </div>
    </div>

    <div class="form-group mt-2">
      <%= f.label :notes, "Notes internes" %>
      <%= f.text_area :notes, rows: 6 %>
    </div>
  </div>

  <div class="form-footer">
    <%= link_to "Retour", admin_order_path(@order), class: "btn btn--outline" %>
    <%= f.submit "Enregistrer", class: "btn btn--primary" %>
  </div>
<% end %>
