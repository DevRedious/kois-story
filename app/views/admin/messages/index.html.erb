<div class="resource-hero">
  <div class="resource-hero__content">
    <div class="resource-hero__eyebrow">Relation client</div>
    <h2 class="resource-hero__title">Demandes et suivi</h2>
    <p class="resource-hero__text">Centralisez les messages recus, reperez ceux qui attendent une action et gardez un suivi simple jusqu'au traitement.</p>
  </div>
  <div class="resource-metrics">
    <div class="resource-metric">
      <span class="resource-metric__label">Nouveaux</span>
      <strong class="resource-metric__value"><%= @message_metrics[:unread] %></strong>
    </div>
    <div class="resource-metric">
      <span class="resource-metric__label">Lus</span>
      <strong class="resource-metric__value"><%= @message_metrics[:read] %></strong>
    </div>
    <div class="resource-metric">
      <span class="resource-metric__label">Traites</span>
      <strong class="resource-metric__value"><%= @message_metrics[:processed] %></strong>
    </div>
  </div>
</div>

<div class="panel panel--messages">
  <div class="panel-header">
    <div class="panel-title">Messages recus</div>
    <div class="panel-toolbar messages-toolbar">
      <label class="sr-only" for="msg-search">Rechercher un message</label>
      <input id="msg-search" type="search" class="u-toolbar-control messages-search" placeholder="Nom, email ou reference">
      <div class="messages-filters" role="group" aria-label="Filtrer les messages">
        <% admin_message_status_options.each do |label, value| %>
          <button type="button" class="messages-filter-chip <%= 'is-active' if value.blank? %>" data-filter-status="<%= value %>"><%= label %></button>
        <% end %>
      </div>
    </div>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Reference</th>
          <th>Expediteur</th>
          <th>Message</th>
          <th>Statut</th>
          <th>Suivi</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @messages.each do |message| %>
          <tr class="<%= admin_message_row_class(message) %>" data-status="<%= message.status %>" data-search="<%= [message.contact_reference, message.sender_name, message.sender_email, message.body].join(' ').downcase %>">
            <td class="msg-date">
              <%= admin_message_datetime(message) %>
              <div class="msg-time"><%= admin_message_time(message) %></div>
            </td>
            <td class="msg-reference"><%= message.contact_reference %></td>
            <td>
              <strong><%= message.sender_name %></strong>
              <div class="msg-email"><%= mail_to message.sender_email %></div>
            </td>
            <td class="msg-preview"><%= admin_message_preview(message) %></td>
            <td>
              <span class="badge <%= admin_message_status_badge_class(message) %>"><%= admin_message_status_label(message) %></span>
            </td>
            <td class="msg-followup"><%= admin_message_follow_up(message) %></td>
            <td>
              <div class="td-actions">
                <%= link_to(message.status == :unread ? "Lire" : "Voir", admin_message_path(message), class: "btn #{message.status == :unread ? 'btn--primary' : 'btn--outline'} btn--sm") %>
                <% if message.status == :unread %>
                  <%= button_to "Marquer lu", admin_message_path(message, status: :read), method: :patch, class: "btn btn--outline btn--sm" %>
                <% end %>
                <% unless message.status == :processed %>
                  <%= button_to "Traiter", admin_message_path(message, status: :processed), method: :patch, class: "btn btn--outline btn--sm" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "admin/shared/pagination", pagination: @pagination, item_name: "messages" %>
</div>
