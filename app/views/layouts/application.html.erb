<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Koi's Story" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= favicon_link_tag "/logo_bg_dark.avif", type: "image/avif" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag content_for(:extra_stylesheet), "data-turbo-track": "reload" if content_for?(:extra_stylesheet) %>
    <%= yield :head if content_for?(:head) %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= content_for(:body_class) if content_for?(:body_class) %>">
    <a href="#main-content" class="skip-link">Aller au contenu principal</a>
    <div class="toast-container">
      <% if notice %>
        <div class="toast toast--notice" data-toast>
          <span class="toast__icon">✓</span>
          <p class="toast__message"><%= notice %></p>
          <button class="toast__close" data-toast-close aria-label="Fermer">×</button>
          <div class="toast__progress"></div>
        </div>
      <% end %>
      <% if alert %>
        <div class="toast toast--alert" data-toast>
          <span class="toast__icon">!</span>
          <p class="toast__message"><%= alert %></p>
          <button class="toast__close" data-toast-close aria-label="Fermer">×</button>
          <div class="toast__progress"></div>
        </div>
      <% end %>
    </div>
    <%= yield %>
    <%= render "layouts/footer" unless content_for?(:skip_default_footer) %>
  </body>
</html>
